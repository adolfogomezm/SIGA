---
import "../styles/global.css";
---

<!doctype html>
<html lang="es" class="m-0 h-full w-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>SIGA</title>
    </head>
    <body
        class="h-screen w-full m-0 min-h-screen bg-gradient-to-tr from-siga-red-normal via-red-900 to-siga-red-bright"
    >
        <header>
            <nav class="">
                <div
                    class="flex justify-between md:justify-around py-4 bg-siga-black/80 backdrop-blur-md shadow-md w-full px-20 fixed top-0 left-0 right-0 z-10 md:px-3"
                >
                    <a href="/" class="flex items-center">
                        <img src="" class="mr-3 h-6 sm:h-9" alt="SIGA logo" />
                        <span
                            class="self-center text-xl font-semibold whitespace-nowrap dark:text-white"
                            >SIGA</span
                        >
                    </a>
                    <div class="flex items-center lg:order-2">
                        <a
                            href="/login"
                            class="text-white hover:bg-gray-50 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 lg:px-5 py-2 lg:py-2.5 mr-2 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800"
                            >Log in</a
                        >
                        <a
                            href="/register"
                            class="text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-4 lg:px-5 py-2 lg:py-2.5 mr-2 dark:bg-primary-600 dark:hover:bg-primary-700 focus:outline-none dark:focus:ring-primary-800"
                            >Get started</a
                        >
                        <button
                            data-collapse-toggle="mobile-menu-2"
                            type="button"
                            class="inline-flex items-center p-2 ml-1 text-sm text-gray-500 rounded-lg lg:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                            aria-controls="mobile-menu-2"
                            aria-expanded="false"
                        >
                            <span class="sr-only">Open main menu</span>
                            <svg
                                class="w-6 h-6"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                                xmlns="http://www.w3.org/2000/svg"
                                ><path
                                    fill-rule="evenodd"
                                    d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                                    clip-rule="evenodd"></path></svg
                            >
                            <svg
                                class="hidden w-6 h-6"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                                xmlns="http://www.w3.org/2000/svg"
                                ><path
                                    fill-rule="evenodd"
                                    d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                    clip-rule="evenodd"></path></svg
                            >
                        </button>
                    </div>
                    <div
                        class="hidden justify-between items-center w-full lg:w-auto lg:order-1"
                        id="mobile-menu-2"
                    >
                        <ul
                            class="flex flex-col mt-4 font-medium lg:flex-row lg:space-x-8 lg:mt-0"
                        >
                            <li>
                                <a
                                    href="#inicio"
                                    class="block py-2 pr-4 pl-3 text-white rounded bg-primary-700 lg:bg-transparent lg:text-primary-700 lg:p-0 dark:text-white"
                                    aria-current="page">Inicio</a
                                >
                            </li>
                            <li>
                                <a
                                    href="#nosotros"
                                    class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700"
                                    >Nosotros</a
                                >
                            </li>
                            <li>
                                <a
                                    href="#porqueSiga"
                                    class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700"
                                    >Uso</a
                                >
                            </li>
                            <li>
                                <a
                                    href="#resultados"
                                    class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700"
                                    >Resultados</a
                                >
                            </li>
                            <li>
                                <a
                                    href="#iniciamos"
                                    class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700"
                                    >Empezar</a
                                >
                            </li>
                            <li>
                                <a
                                    href="#contacto"
                                    class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700"
                                    >Contacto</a
                                >
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <main>
            <section
                class="flex flex-wrap items-center -mx-10 font-sans px-8 mx-auto w-full h-[100vh] lg:max-w-screen-lg sm:max-w-screen-sm md:max-w-screen-md text-white"
            >
                <!-- Column-1 -->
                <div class="px-3 w-full lg:w-2/5">
                    <div
                        class="mx-auto mb-8 max-w-lg text-center lg:mx-0 lg:max-w-md lg:text-left"
                    >
                        <h2
                            class="mb-4 text-3xl font-bold text-left lg:text-5xl"
                        >
                            Publica lo que quieras en

                            <span
                                class="text-5xl text-[#0dccd6] leading-relaxeds"
                                >SIGA,
                            </span>

                            la solución perfecta.
                        </h2>

                        <p
                            class="visible mx-0 mt-3 mb-0 text-sm leading-relaxed text-left text-slate-400"
                        >
                            Guardamos tus articulos por ti.
                        </p>
                    </div>

                    <div class="text-center lg:text-left">
                        <a
                            class="block visible py-4 px-8 mb-4 text-xs font-semibold tracking-wide leading-none text-black bg-[#0dccd6] rounded cursor-pointer sm:mr-3 sm:mb-0 sm:inline-block"
                            href="/login">Inicia Sesión</a
                        >

                        <a
                            class="block visible py-4 px-8 text-xs font-semibold leading-none bg-white rounded border border-solid cursor-pointer sm:inline-block border-slate-200 text-black"
                            href="/register">¡Registrate!</a
                        >
                    </div>
                </div>

