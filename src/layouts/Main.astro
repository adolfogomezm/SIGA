---
import "../styles/global.css";
---
<!doctype html>
<html lang="es" class="m-0 h-full w-full" >
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="min-h-screen w-full flex flex-col m-0">

	<header class="h-[12vh] flex-shrink-0 bg-siga-red-normal text-3xl flex items-center px-8">
		<h1 class="text-white font-semibold">SIGA</h1>
	</header>

	<div class="flex flex-1">

		<nav class="w-1/5">
			<div class="sticky top-0 h-screen overflow-y-auto bg-gray-100">
				<slot />
			</div>
		</nav>

		<main class="flex-1 p-8">
			<slot name="main" />
		</main>

	</div>

	</body>
</html>

