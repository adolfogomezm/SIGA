---
import "../styles/global.css";

const authorLinks = [
    {text: "Mis Articulos", link: "/autor/articulos"},
    {text: "Subir Artículo", link: "/autor/subirArticulo"},
];

const reviewerLinks = [
    {text: "Artículos a Revisar", link: "/revisor"},
];

const menu = {
    autor: authorLinks,
    revisor: [...authorLinks, ...reviewerLinks],
    administrador: [
        {text: "Todos Los Artículos", link: "/administrador/todosLosArticulos"},
        {text: "Usuarios", link: "/administrador/usuarios"},
    ],
};

type Role = keyof typeof menu;
interface Props {
    role: Role;
}
const { role } = Astro.props;
const links = menu[role];
---
<aside class="bg-siga-black h-full w-full">
    <nav class="flex-col flex">
        {links.map((item) =>(
            <a href={item.link} class="text-2xl p-5 text-center text-gray-300 transition-all duration-200 hover:scale-105 hover:bg-amber-950  hover:shadow-xl active:scale-95 focus:outline-none focus:ring-4 focus:ring-indigo-300 focus:border-indigo-700">{item.text}</a>
        )) }
    </nav>
</aside>