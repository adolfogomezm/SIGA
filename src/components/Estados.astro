---
import CardContainer from './CardContainer.astro';
---
<CardContainer>
    <slot>
        <div class="text-4xl font-bold text-[#5F1333] mb-8">
            Mis Artículos
        </div>
    </slot>
</CardContainer>
<div class="w-full flex flex-wrap justify-center items-center gap-10 mt-10">
    <div class="bg-siga-red-normal p-8 w-3/4 max-w-3/4 md:max-w-2/5 xl:max-w-1/5">
        <p id="numeroEnviados" class="number text-4xl font-semibold text-white text-center">

        </p>
        <p class="text-2xl font-semibold text-white text-center pt-3">
            Enviado
        </p>
    </div>
    <div class="bg-amber-600 p-8 w-3/4 max-w-3/4 md:max-w-2/5 xl:max-w-1/5">
        <p id="numeroEnviados" class="number text-4xl font-semibold text-white text-center">

        </p>
        <p class="text-2xl font-semibold text-white text-center pt-3">
            En Revision
        </p>
    </div>
    <div class="bg-green-700 p-8 w-3/4 max-w-3/4 md:max-w-2/5 xl:max-w-1/5">
        <p id="numeroEnviados" class="number text-4xl font-semibold text-white text-center">

        </p>
        <p class="text-2xl font-semibold text-white text-center pt-3">
            Aprobados
        </p>
    </div>
    <div class="bg-orange-700 p-8 w-3/4 max-w-3/4 md:max-w-2/5 xl:max-w-1/5">
        <p id="numeroEnviados" class="number text-4xl font-semibold text-white text-center">

        </p>
        <p class="text-2xl font-semibold text-white text-center pt-3">
            Rechazados
        </p>
    </div>
</div>

<script>
    import { actions } from 'astro:actions';

    async function cargarYFiltrar() {
        const { data, error } = await actions.getArticulos();

        if (error) {
            console.error("Error al obtener datos:", error.message);
            return;
        }
        const numberOfDocuments = document.querySelectorAll('.number');
        if(!numberOfDocuments){
            return;
        }
        numberOfDocuments.forEach((element) => {
           let count = 0;
           for(let doc in data){
               if(data[doc].articulo.estado === element.nextElementSibling.textContent.trim()){
                   count++;
               }
           }
           element.textContent = count.toString();
        });
    }

    cargarYFiltrar();
</script>
