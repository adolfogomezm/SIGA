---
const { nombre } = Astro.props;
---
<div class="flex items-center justify-between bg-[#F0EDED] border border-[#E0E0E0] p-1 pl-4 mb-3">
    <span class="text-gray-700 font-medium">{nombre}</span>
    <button class="bg-[#C13D5E] text-white p-2 px-4 hover:bg-[#5F1333] transition-colors">
        <span class="text-xl">→</span>
    </button>
</div>
