---
import StatusBadge from './StatusBadge.astro';
const { id, href, titulo, autor, estado, revisores } = Astro.props;
---
<tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
    <td class="p-4 text-gray-600">{id}</td>
    <td class="p-4 text-gray-700 font-medium">{titulo}</td>
    <td class="p-4 text-gray-600">{autor}</td>
    <td class="p-4"><StatusBadge estado={estado} /></td>
    <td class="p-4 text-center text-gray-600 font-semibold">{revisores}</td>
    <td class="p-4 text-center">
        <a href={href} class="bg-[#5F1333] text-white px-4 py-2 text-sm rounded-sm hover:bg-[#4a0e28] inline-block mt-0 mb-0">
            Ver
        </a>
    </td>
</tr>