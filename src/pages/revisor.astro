---
import Main from '../layouts/Main.astro';
import Sidebar from "../components/Sidebar.astro";
import CardContainer from '../components/CardContainer.astro';
import RevisoresAsignados from '../components/RevisoresAsignados.astro';
import RevisoresDisponibles from '../components/RevisoresDisponibles.astro';
---
<Main>
    <Sidebar role="revisor">
    </Sidebar>
    <main slot="main" class="m-8 w-full h-full">
        <h1 class="text-4xl font-bold mb-10">Bienvenido Revisor</h1>
        <div class="grid grid-cols-2 gap-12">
            <CardContainer>
                <h2 class="text-siga-red-dark font-bold mb-4">Revisores Disponibles</h2>
                <RevisoresDisponibles nombre="Dr. Revisor 1" />
                <RevisoresDisponibles nombre="Dra. Revisor 2" />
                <RevisoresDisponibles nombre="Dr. Revisor 3" />
            </CardContainer>

            <CardContainer>
                <h2 class="text-siga-red-dark font-bold mb-4">Revisores Asignados (0/3)</h2>
                <RevisoresAsignados texto="Revisor 1 — Sin asignar" />
                <RevisoresAsignados texto="Revisor 2 — Sin asignar" />
                <RevisoresAsignados texto="Revisor 3 — Sin asignar" />

                <button class="w-full bg-siga-red-dark text-white py-3 mt-4 font-bold uppercase">
                    Confirmar Asignación
                </button>
            </CardContainer>
        </div>
    </main>
</Main>


