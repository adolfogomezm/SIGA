---
import Main from '../../layouts/Main.astro'
import Sidebar from '../../components/Sidebar.astro'
import CardContainer from "../../components/CardContainer.astro";
import Estados from '../../components/Estados.astro';
import TableArticulos from '../../components/tableArticulos.astro';
import { actions } from 'astro:actions';

const userRole = Astro.cookies.get('user_role')?.value as 'autor' | 'revisor' | 'administrador' || 'autor';
const sidebarRole = userRole === 'revisor' ? 'revisor' : 'autor';

const { data: articulos, error } = await Astro.callAction(actions.getArticulos, {});
const qtty = articulos?.length || 0;
const isLimitReached = qtty >= 3;
---
<Main>
    <Sidebar role={sidebarRole} />
    <main slot="main" class="p-8 w-full bg-[#F3F2F3] min-h-screen">
        { !isLimitReached ? (
        <div class="fixed right-8 bottom-8 right-10 z-1000 bg-siga-red-normal p-4 shadow-lg w-fit text-white lg:w-1/4 lg:text-center hover:bg-siga-red-dark transition-colors cursor-pointer rounded-sm">
            <a href="subirArticulo" class="w-full h-full block font-bold text-lg">
                + Nuevo Envío
            </a>
        </div>
        ) : (
        <div class="fixed right-8 bottom-8 right-10 z-[1000] bg-gray-500 p-4 shadow-lg w-fit text-white lg:w-1/4 lg:text-center rounded-sm">
            <span class="w-full h-full block font-bold text-lg" title="Límite máximo de 3 artículos alcanzado">
                Límite de Envíos Alcanzado
            </span>
        </div>
        )}
        
        <Estados />
        
        <div class="mt-12 px-10">
            <h2 class="text-[#5F1333] font-bold text-2xl uppercase tracking-wider mb-2">Mis Trabajos</h2>
            <hr class="border-[#5F1333] mb-6"/>
        </div>
        <TableArticulos/>
    </main>
</Main>
